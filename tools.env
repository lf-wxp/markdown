# 构建工具版本的唯一来源。
#
# CI（.github/workflows/deploy.yml）、Dockerfile 和 cargo make setup 都从这里取值。
# 早先三处各自声明：CI 与 Dockerfile 钉死版本，而 `cargo make setup` 装的是最新版，
# 于是本地和线上可能跑在不同的 mdbook 上——这正是「本地能过、CI 挂掉」的来源，
# 而 mdbook-toc 0.14 与 mdBook 0.5 不兼容这类坑已经踩过一次。
#
# 格式限制：这个文件会被 shell `.` 进去，只能写 KEY=value，不要有空格和引号。

MDBOOK_VERSION=0.5.4

# 需 >= 0.15：0.14.x 与 mdBook 0.5 不兼容，
# 会导致 "The toc preprocessor exited unsuccessfully"
MDBOOK_TOC_VERSION=0.15.4

# 必须以 extended feature 安装，否则没有 CJK 分词能力（见 Makefile.toml）
PAGEFIND_VERSION=1.5.2
